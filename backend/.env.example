# ── Claude API (Anthropic) — powers AI dashboard insights + winner coupon copy ─
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Defaults to claude-haiku-4-5 in code if unset — cheapest tier, chosen for
# the $5/mo Railway plan (this is a cached-every-10-minutes internal summary).
CLAUDE_DEFAULT_MODEL=claude-haiku-4-5

# ── Purchase stats — reuses the SAME Square credentials as cungus/backend ─────
# (developer.squareup.com). Leave unset to show clearly-labeled mock data
# instead of crashing.
SQUARE_ACCESS_TOKEN=your_square_access_token_here
SQUARE_LOCATION_ID=your_square_location_id_here
SQUARE_ENV=sandbox

# ── carspootz (Veynor) leaderboard — public read-only API, no key needed ──────
# Override only if the Railway URL changes.
CARSPOOTZ_API_BASE=https://veynor-background-production.up.railway.app

# ── Bettermade's live backend — used only for the /api/connections status
# check (pings its root). Override only if the Railway URL changes.
BETTERMADE_API_BASE=https://apex-backend-production-5cec.up.railway.app

# ── Dashboard password ─────────────────────────────────────────────────────
# Required to lock down /api/* (everything except GET /). Pick your own —
# do NOT reuse a password from anywhere else. Leave blank only for local dev;
# an unset password means the API is wide open.
DASHBOARD_PASSWORD=

# ── Mambru unified backend — coupons/sales/stats, replaces the old
# winners.json monthly-coupon hack. MAMBRU_DASHBOARD_PASSWORD authenticates
# this backend AS A CLIENT of mambru (distinct from DASHBOARD_PASSWORD
# above, which gates this dashboard's own UI) — use the same value as
# mambru-backend's seeded ADMIN_PASSWORD.
MAMBRU_URL=http://localhost:4200
MAMBRU_DASHBOARD_PASSWORD=

# ── App Store downloads — NOT wired up yet (needs a paid Apple Developer
# account + an App Store Connect API key: Users and Access → Integrations →
# App Store Connect API → Generate Key, with "Sales and Reports" access).
# Until these are set, /api/stats/downloads returns clearly-labeled mock data.
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
APPSTORE_PRIVATE_KEY_PATH=

PORT=4100
